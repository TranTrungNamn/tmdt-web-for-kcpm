name: TechVie Postman Automation

on:
  push:
    branches:
      - main

  pull_request:
    branches:
      - main

  workflow_dispatch:

jobs:
  prepare-postman-automation:
    name: Prepare Postman/Newman Automation
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: backend/package-lock.json

      - name: Install backend dependencies
        working-directory: backend
        run: npm ci

      - name: Install Newman
        run: npm install --global newman

      - name: Verify Newman installation
        run: newman --version

      - name: Workflow ready
        run: |
          echo "TechVie Postman Automation workflow is ready."
          echo "Newman has been installed successfully."
